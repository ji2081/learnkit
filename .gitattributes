# Normalize line endings to LF across platforms.
* text=auto eol=lf

# Text formats used in this project.
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.ipynb text eol=lf
*.sh text eol=lf

# Binary assets (if added later).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
